#!/bin/bash
# ai-brain: helper and maintenance utility for AI-Brains

   if [ "$*" == "-?" ]; then
      ai-brain ---g "   ai-brain: helper and maintenance utility for AI-Brains (version `ai-brain --version`)"
      echo '   usage: ai-brain --setup       # install hook into AI-Brain'
      echo '          ai-brain --cleanup     # remove hook'
      echo '          ai-brain --demo        # create example AI-Brain at ~/§Privat'
      echo '          ai-brain --context     # print masterspace context along cwd path'
      echo '          ai-brain --id          # print masterspace id (id=… files=… cwd=…)'
      echo '          ai-brain --load        # split context into part files for reading'
      echo '          ai-brain --tutorial    # step-by-step setup walkthrough'
      echo '          ai-brain --help        # comprehensive help'
      echo '          ai-brain --version     # print version'
      echo '          ai-brain --check       # verify required dependencies are installed'
      echo '          ai-brain -!            # install ai-brain into a PATH directory'
      echo '   see also: chk, pimp'
      exit 1
   fi

#===============================================================================
# comprehensive help: ai-brain --help
#===============================================================================

   if [ "$*" == "--help" ]; then
      echo '   ai-brain — central CLI for an AI-Brain'
      echo ''
      ai-brain ---g '   Concept:'
      echo '     An AI-Brain is a directory hierarchy whose root starts with'
      echo '     a §-prefix, where each node may carry an @-subfolder (the'
      echo '     masterspace). On every AI query the masterspaces along the'
      echo '     cwd path are activated as context.'
      echo ''
      ai-brain ---g '   Commands:'
      ai-brain ---y '     ai-brain --setup'
      echo '         Merges two hooks into ~/.claude/settings.json: a SessionStart'
      echo '         hook (ai-brain --session) and a UserPromptSubmit hook'
      echo '         (ai-brain --advise). Existing settings are preserved.'
      echo ''
      ai-brain ---y '     ai-brain --cleanup'
      echo '         Removes both ai-brain hooks from ~/.claude/settings.json.'
      echo '         Masterspaces and directory structure remain untouched.'
      echo ''
      ai-brain ---y '     ai-brain --demo'
      echo '         Creates the example AI-Brain at ~/§Privat — directory tree'
      echo '         plus seven pre-populated masterspace .md files covering'
      echo '         recipes (with dishes/drinks sub-branches) and electronics'
      echo '         development (power + RF sub-branches). Refuses to run if'
      echo '         ~/§Privat already exists.'
      echo ''
      ai-brain ---y '     ai-brain --session'
      echo '         SessionStart hook (startup, resume, clear, compact). Reads'
      echo '         the hook JSON from stdin (cwd). If the context fits into'
      echo '         $AI_BRAIN_INLINE_LIMIT characters (default 9000), it is'
      echo '         injected directly; otherwise a mandatory instruction to'
      echo '         read the part files of ai-brain --load is emitted.'
      echo ''
      ai-brain ---y '     ai-brain --advise'
      echo '         UserPromptSubmit hook. Emits the expected masterspace id'
      echo '         for the cwd and tells Claude to reload (ai-brain --load)'
      echo '         if the matching begin/end markers are not in its context.'
      echo '         Safety net for a missing SessionStart hook or a changed'
      echo '         masterspace.'
      echo ''
      ai-brain ---y '     ai-brain --context'
      echo '         Walks from the filesystem root down to the current'
      echo '         directory, collecting every @-subfolder along the way and'
      echo '         printing its .md contents as <skill src="…"> blocks,'
      echo '         enclosed in <masterspace id="…"> … </masterspace id="…">.'
      echo ''
      ai-brain ---y '     ai-brain --id'
      echo '         Prints "id=<8 hex> files=<n> cwd=<path>". The id is a hash'
      echo '         over cwd, file paths and contents — it changes whenever'
      echo '         the project folder or any masterspace file changes.'
      echo '         Prints "no AI-Brain" outside of a §-rooted hierarchy.'
      echo ''
      ai-brain ---y '     ai-brain --load'
      echo '         Writes the context into part files (<= 40 KB each) under'
      echo '         ~/.claude/masterspace/<id>/ and prints the list of files'
      echo '         Claude has to read completely. Used by --session, --advise'
      echo '         and the /masterspace skill.'
      echo ''
      ai-brain ---y '     ai-brain --tutorial'
      echo '         Prints a step-by-step setup walkthrough with copy-paste'
      echo '         ready bash blocks.'
      echo ''
      ai-brain ---y '     ai-brain --version'
      echo '         Prints the version number.'
      echo ''
      ai-brain ---y '     ai-brain --check'
      echo '         Verifies that the required dependencies (jq, shasum, Claude'
      echo '         Code as CLI or bundled with the desktop app) and the optional'
      echo '         one (tree) are available; reports OK/FAIL/WARN per item with'
      echo '         a fix hint. Exit 0 if all required pass.'
      echo ''
      ai-brain ---g '   Conventions:'
      echo '     §<name>/        AI-Brain root'
      echo '     @/              masterspace (context files)'
      echo '     .claude/        configuration folder (settings.json)'
      echo ''
      echo '   see also: chk, pimp'
      exit 1
   fi

#===============================================================================
# print version: ai-brain --version  (short form: --v)
#===============================================================================

   if [ "$*" == "--version" ] || [ "$*" == "--v" ]; then
      echo "1.4.0"; exit 0
   fi

#===============================================================================
# advise hook: ai-brain --advise  (UserPromptSubmit hook, reads hook JSON)
#===============================================================================

   if [ "$*" == "--advise" ]; then
      if [ ! -t 0 ]; then                # hook JSON on stdin: use its cwd
         CWD="$(jq -r '.cwd // empty' 2>/dev/null)"
         if [ -n "$CWD" ] && [ -d "$CWD" ]; then cd "$CWD" || exit 0; fi
      fi
      if [ -z "$(ai-brain ---root)" ]; then
         exit 0                          # not inside an AI-Brain: stay silent
      fi
      read -r ID N <<< "$(ai-brain ---hash)"
      echo "MASTERSPACE-CHECK: expected masterspace id=$ID (files=$N, cwd=$PWD)."
      echo " Before answering, verify that BOTH exact markers <masterspace id=\"$ID\""
      echo " and </masterspace id=\"$ID\"> are present in your context (memory or a"
      echo " summary of earlier loading does not count). If not: tell the user"
      echo " \"Lade Masterspace\", run \`ai-brain --load\` via Bash, read every listed"
      echo " part file completely with the Read tool, then tell the user"
      echo " \"Masterspace geladen (id $ID)\". If both markers are present, do nothing."
      exit 0
   fi

#===============================================================================
# session hook: ai-brain --session  (SessionStart hook, reads hook JSON)
#===============================================================================

   if [ "$*" == "--session" ]; then
      if [ ! -t 0 ]; then                # hook JSON on stdin: use its cwd
         CWD="$(jq -r '.cwd // empty' 2>/dev/null)"
         if [ -n "$CWD" ] && [ -d "$CWD" ]; then cd "$CWD" || exit 0; fi
      fi
      if [ -z "$(ai-brain ---root)" ]; then
         exit 0                          # not inside an AI-Brain: stay silent
      fi
      LIMIT="${AI_BRAIN_INLINE_LIMIT:-9000}"
      CTX="$(ai-brain --context 2>/dev/null)"
      if [ "${#CTX}" -le "$LIMIT" ]; then
         echo "MASTERSPACE (loaded automatically by SessionStart hook):"
         printf '%s\n' "$CTX"
      else
         echo "MASTERSPACE-MANDATORY: the masterspace for this project is too large"
         echo " for direct injection (${#CTX} > $LIMIT characters). Before your first"
         echo " answer, tell the user \"Lade Masterspace\", read every part file listed"
         echo " below completely with the Read tool, then tell the user"
         echo " \"Masterspace geladen\"."
         ai-brain --load
      fi
      exit 0
   fi

#===============================================================================
# masterspace id: ai-brain --id
#===============================================================================

   if [ "$*" == "--id" ]; then
      if [ -z "$(ai-brain ---root)" ]; then
         echo "no AI-Brain"
         exit 0
      fi
      read -r ID N <<< "$(ai-brain ---hash)"
      echo "id=$ID files=$N cwd=$PWD"
      exit 0
   fi

#===============================================================================
# part files: ai-brain --load  (context split into <= 40 KB part files)
#===============================================================================

   if [ "$*" == "--load" ]; then
      if [ -z "$(ai-brain ---root)" ]; then
         echo "no AI-Brain"
         exit 0
      fi
      read -r ID N <<< "$(ai-brain ---hash)"
      CACHE="$HOME/.claude/masterspace"
      DIR="$CACHE/$ID"
      if [ ! -f "$DIR/.complete" ]; then
         rm -rf "$DIR"
         mkdir -p "$DIR" || exit 1
         ai-brain --context 2>/dev/null | awk -v dir="$DIR" -v max=40000 '
            BEGIN { p = 1; n = 0 }
            {
               if (n > 0 && n + length($0) + 1 > max) { close(f); p++; n = 0 }
               f = sprintf("%s/part-%d.md", dir, p)
               print > f
               n += length($0) + 1
            }' || exit 1
         touch "$DIR/.complete"
      fi
      # drop cached part files of outdated masterspaces (older than 7 days)
      find "$CACHE" -mindepth 1 -maxdepth 1 -type d -mtime +7 -exec rm -rf {} + 2>/dev/null
      P=$(ls "$DIR"/part-*.md | wc -l | tr -d ' ')
      echo "MASTERSPACE-LOAD id=$ID files=$N parts=$P cwd=$PWD"
      echo "Read each of the following part files completely (Read tool), in order:"
      ls "$DIR"/part-*.md | sort -t- -k2 -n | sed 's/^/   /'
      echo "The masterspace is loaded once </masterspace id=\"$ID\"> (end of the last part) has been read."
      exit 0
   fi

#===============================================================================
# check dependencies: ai-brain --check
#===============================================================================

   if [ "$*" == "--check" ]; then
      ai-brain ---c "checking ai-brain dependencies ..."
      ERR=0

      # jq — JSON manipulation, used by --setup and --cleanup
      if command -v jq >/dev/null 2>&1; then
         ai-brain ---g "  OK:   jq (JSON manipulator, used by --setup/--cleanup)"
      else
         ai-brain ---r "  FAIL: jq not found => brew install jq   or   apt install jq"
         ERR=1
      fi

      # shasum — hashing of the masterspace id (--id, --context, --advise)
      if command -v shasum >/dev/null 2>&1; then
         ai-brain ---g "  OK:   shasum (masterspace id)"
      else
         ai-brain ---r "  FAIL: shasum not found => install perl (shasum ships with perl)"
         ERR=1
      fi

      # claude — Claude Code, either as CLI on PATH or bundled with the
      # Claude desktop app (Code tab), which has no claude on PATH
      APP=$(ls -d "$HOME/Library/Application Support/Claude/claude-code/"*/claude.app 2>/dev/null | tail -1)
      if command -v claude >/dev/null 2>&1; then
         ai-brain ---g "  OK:   claude (Claude Code CLI)"
      elif [ -n "$APP" ]; then
         ai-brain ---g "  OK:   claude (Claude Code bundled with the Claude desktop app)"
      else
         ai-brain ---r "  FAIL: Claude Code not found => https://docs.claude.com/en/docs/claude-code"
         ERR=1
      fi

      # tree — optional, used by the embedded tutorial for directory visualization
      if command -v tree >/dev/null 2>&1; then
         ai-brain ---g "  OK:   tree (optional, used by tutorial for directory visualization)"
      else
         ai-brain ---m "  WARN: tree not found (optional) => brew install tree   or   apt install tree"
      fi

      if [ "$ERR" != 0 ]; then
         ai-brain ---r "=> required dependencies missing"
         exit 1
      fi
      ai-brain ---g "=> all required dependencies installed"
      exit 0
   fi

#===============================================================================
# tutorial: ai-brain --tutorial  (step-by-step setup walkthrough)
#===============================================================================

   if [ "$*" == "--tutorial" ]; then
      ai-brain ---g 'AI-Brain — Step-by-Step Setup Tutorial'
      echo ''
      ai-brain ---c 'Step 1: Create the directory tree'
      echo ''
      cat <<'BLOCK'
mkdir -p \
  ~/§Privat/.claude \
  ~/§Privat/@ \
  ~/§Privat/Lieblingsrezepte/@ \
  ~/§Privat/Lieblingsrezepte/Lieblingsspeisen/@ \
  ~/§Privat/Lieblingsrezepte/Lieblingsgetränke/@ \
  ~/§Privat/Elektronikentwicklung/@ \
  ~/§Privat/Elektronikentwicklung/Leistungselektronik/@ \
  ~/§Privat/Elektronikentwicklung/HF-Elektronik/@
BLOCK
      echo ''
      ai-brain ---c 'Step 2: Inspect the directory tree'
      echo ''
      cat <<'BLOCK'
tree -a ~/§Privat
BLOCK
      echo ''
      ai-brain ---c 'Step 3: Fill the masterspaces'
      echo ''
      ai-brain ---c 'Root masterspace (applies to every query):'
      echo ''
      cat <<'BLOCK'
cat > ~/§Privat/@/persoenliche-allgemein.md <<'EOF'
# Persönliche allgemeine Präferenzen

- Sprache: Deutsch
- Anrede: Du
- Stil: knapp, sachlich, direkt
- Bei Code-Beispielen: kommentiere sparsam, nur wo es nicht-offensichtlich ist
EOF
BLOCK
      echo ''
      ai-brain ---c 'Recipes masterspace:'
      echo ''
      cat <<'BLOCK'
cat > ~/§Privat/Lieblingsrezepte/@/rezept-vorlieben.md <<'EOF'
# Rezept-Vorlieben

- Wenig Zucker, wenn möglich
- Bevorzugt mediterrane und alpenländische Küche
- Keine Erdnüsse (Allergie im Haushalt)
- Mengenangaben in Gramm und Esslöffeln, nicht in Cups
EOF
BLOCK
      echo ''
      ai-brain ---c 'Dishes subspace:'
      echo ''
      cat <<'BLOCK'
cat > ~/§Privat/Lieblingsrezepte/Lieblingsspeisen/@/speisen-praeferenzen.md <<'EOF'
# Speisen-Präferenzen

- Bevorzugte Garmethoden: Schmoren, Niedertemperatur, Backofen
- Lieblings-Aromen: Rosmarin, Thymian, Knoblauch, Zitrone
- Vegetarisch ist willkommen, muss aber nicht sein
EOF
BLOCK
      echo ''
      ai-brain ---c 'Step 4: Inspect the populated tree'
      echo ''
      cat <<'BLOCK'
tree -a ~/§Privat
BLOCK
      echo ''
      ai-brain ---c 'Step 5: Install the hook'
      echo ''
      cat <<'BLOCK'
ai-brain --setup
BLOCK
      echo ''
      ai-brain ---c 'Step 6: First probe query'
      echo ''
      cat <<'BLOCK'
cd ~/§Privat/Lieblingsrezepte/Lieblingsspeisen
claude
BLOCK
      echo ''
      echo 'Inside Claude, try a prompt such as:'
      echo '"Suggest an apple-strudel variation with less sugar."'
      echo ''
      ai-brain ---c 'Step 7: Verify'
      echo ''
      ai-brain ---c 'Direct context probe (shows what Claude would receive):'
      echo ''
      cat <<'BLOCK'
cd ~/§Privat/Lieblingsrezepte/Lieblingsspeisen
ai-brain --context
BLOCK
      echo ''
      ai-brain ---c 'Side-branch comparison (Elektronik instead of Rezepte):'
      echo ''
      cat <<'BLOCK'
cd ~/§Privat/Elektronikentwicklung/Leistungselektronik
ai-brain --context
BLOCK
      echo ''
      echo 'Different masterspaces should be activated.'
      echo ''
      ai-brain ---c 'Step 8 (optional): Remove the hook'
      echo ''
      cat <<'BLOCK'
ai-brain --cleanup
BLOCK
      echo ''
      exit 1
   fi

#===============================================================================
# install: ai-brain -!   (curl-installed scratch file copies itself to PATH dir)
#===============================================================================

   if [ "$*" == "-!" ]; then
      if [ ! -f ~ai-brain ]; then
         echo "error: ai-brain -!  needs file ~ai-brain in current directory" >&2
         echo "       (created by the curl install one-liner — see README)" >&2
         exit 1
      fi
      chmod +x ~ai-brain

      echo "select target directory for installation of ai-brain:"
      LIST=$(echo "$PATH" | tr ':' ' ')
      select DIR in $LIST
      do
         if [ "$DIR" == "" ]; then
            exit 0
         fi
         ERR="0"
         touch "$DIR/_junk_" 2>/dev/null || ERR="1"
         rm -f "$DIR/_junk_" 2>/dev/null

         ai-brain ---g "=== installing ai-brain in $DIR ..."
         if [ "$ERR" == "0" ]; then
            ai-brain ---y "  cp ~ai-brain $DIR/ai-brain"
            cp ~ai-brain "$DIR/ai-brain" || exit 1
         else
            ai-brain ---c "  this is a protected directory which uses a password!"
            ai-brain ---y "  sudo cp ~ai-brain $DIR/ai-brain"
            sudo cp ~ai-brain "$DIR/ai-brain" || exit 1
         fi
         ai-brain ---g "=== successful installation of ai-brain"
         echo "  => enter: ai-brain -?   # to see usage"

         rm -f ~ai-brain
         exit 0
      done
      exit 0
   fi

#===============================================================================
# setup hook: ai-brain --setup   (merges hook into ~/.claude/settings.json)
#===============================================================================

   if [ "$*" == "--setup" ]; then
      if ! command -v ai-brain >/dev/null 2>&1; then
         ai-brain ---r "ai-brain not found on PATH"
         ai-brain ---r "   install ai-brain into a PATH directory first (e.g. ai-brain -!)"
         exit 1
      fi
      HOOK_CMD="ai-brain --advise"
      SETTINGS="$HOME/.claude/settings.json"

      SESSION_CMD="ai-brain --session"
      ai-brain ---c "hook commands: $HOOK_CMD, $SESSION_CMD"
      ai-brain ---c "settings file: $SETTINGS"

      ai-brain ---y "=> ensuring $(dirname "$SETTINGS") exists"
      mkdir -p "$(dirname "$SETTINGS")" || exit 1

      INPUT=$(cat "$SETTINGS" 2>/dev/null || echo '{}')
      if ! printf '%s' "$INPUT" | jq empty 2>/dev/null; then
         ai-brain ---r "$SETTINGS exists but is not valid JSON. Aborting."
         exit 1
      fi

      ai-brain ---y "=> merging UserPromptSubmit + SessionStart hooks into settings.json"
      NEW=$(printf '%s' "$INPUT" | jq --arg cmd "$HOOK_CMD" --arg scmd "$SESSION_CMD" '
        def ensure($ev; $c):
          .hooks[$ev] //= []
          | if any(.hooks[$ev][];
                   (.hooks // [])[]?.command
                   | ((. == $c) or endswith("/" + $c)))
            then .
            else .hooks[$ev] += [{hooks: [{type: "command", command: $c}]}]
            end;
        .hooks //= {}
        | ensure("UserPromptSubmit"; $cmd)
        | ensure("SessionStart"; $scmd)
      ') || exit 1

      TMP=$(mktemp)
      printf '%s\n' "$NEW" > "$TMP"
      mv "$TMP" "$SETTINGS" || exit 1

      ai-brain ---g "OK — hooks installed in $SETTINGS"
      exit 0
   fi

#===============================================================================
# cleanup hook: ai-brain --cleanup   (removes hook from ~/.claude/settings.json)
#===============================================================================

   if [ "$*" == "--cleanup" ]; then
      SETTINGS="$HOME/.claude/settings.json"

      ai-brain ---c "settings file: $SETTINGS"

      if [ ! -f "$SETTINGS" ]; then
         ai-brain ---m "no $SETTINGS to clean"
         exit 0
      fi

      INPUT=$(cat "$SETTINGS")
      if ! printf '%s' "$INPUT" | jq empty 2>/dev/null; then
         ai-brain ---r "$SETTINGS exists but is not valid JSON. Aborting."
         exit 1
      fi

      ai-brain ---y "=> removing UserPromptSubmit/SessionStart entries that invoke ai-brain --advise, --session or --context"
      NEW=$(printf '%s' "$INPUT" | jq '
        def ours: any(.command | (
                    (. == "ai-brain --advise")  or endswith("/ai-brain --advise")  or
                    (. == "ai-brain --session") or endswith("/ai-brain --session") or
                    (. == "ai-brain --context") or endswith("/ai-brain --context")
                  ));
        def strip($ev):
          if .hooks[$ev] then
            .hooks[$ev] |= map(select((.hooks // []) | ours | not))
            | if .hooks[$ev] == [] then del(.hooks[$ev]) else . end
          else . end;
        if .hooks then
          strip("UserPromptSubmit") | strip("SessionStart")
          | if .hooks == {} then del(.hooks) else . end
        else . end
      ') || exit 1

      TMP=$(mktemp)
      printf '%s\n' "$NEW" > "$TMP"
      mv "$TMP" "$SETTINGS" || exit 1

      ai-brain ---g "OK — hooks removed from $SETTINGS"
      exit 0
   fi

#===============================================================================
# demo: ai-brain --demo  (creates example AI-Brain at ~/§Privat)
#===============================================================================

   if [ "$*" == "--demo" ]; then
      if [ -d ~/§Privat ]; then
         ai-brain ---r "~/§Privat already exists — refusing to overwrite"
         ai-brain ---r "   delete it manually (rm -rf ~/§Privat) if you really want to re-create the demo"
         exit 1
      fi

      ai-brain ---y "=> creating directory tree under ~/§Privat"
      mkdir -p \
         ~/§Privat/@ \
         ~/§Privat/Lieblingsrezepte/@ \
         ~/§Privat/Lieblingsrezepte/Lieblingsspeisen/@ \
         ~/§Privat/Lieblingsrezepte/Lieblingsgetränke/@ \
         ~/§Privat/Elektronikentwicklung/@ \
         ~/§Privat/Elektronikentwicklung/Leistungselektronik/@ \
         ~/§Privat/Elektronikentwicklung/HF-Elektronik/@ || exit 1

      ai-brain ---y "=> writing root masterspace"
      cat > ~/§Privat/@/persoenliche-allgemein.md <<'EOF'
# Persönliche allgemeine Präferenzen

- Sprache: Deutsch
- Anrede: Du
- Stil: knapp, sachlich, direkt
- Bei Code-Beispielen: kommentiere sparsam, nur wo es nicht-offensichtlich ist
EOF

      ai-brain ---y "=> writing Lieblingsrezepte masterspaces"
      cat > ~/§Privat/Lieblingsrezepte/@/rezept-vorlieben.md <<'EOF'
# Rezept-Vorlieben

- Wenig Zucker, wenn möglich
- Bevorzugt mediterrane und alpenländische Küche
- Keine Erdnüsse (Allergie im Haushalt)
- Mengenangaben in Gramm und Esslöffeln, nicht in Cups
EOF

      cat > ~/§Privat/Lieblingsrezepte/Lieblingsspeisen/@/speisen-praeferenzen.md <<'EOF'
# Speisen-Präferenzen

- Bevorzugte Garmethoden: Schmoren, Niedertemperatur, Backofen
- Lieblings-Aromen: Rosmarin, Thymian, Knoblauch, Zitrone
- Vegetarisch ist willkommen, muss aber nicht sein
EOF

      cat > ~/§Privat/Lieblingsrezepte/Lieblingsgetränke/@/getraenke-vorlieben.md <<'EOF'
# Getränke-Präferenzen

- Bevorzugte Tees: Earl Grey, Sencha, Pfefferminze
- Lieblings-Cocktails: Old Fashioned, Negroni, Aperol Spritz
- Alkoholfrei: hausgemachte Sirupe (Holunder, Ingwer-Zitrone, Hibiskus)
- Kaffee: Espresso aus mittlerer Röstung, italienisch
- Wein: trockene Weiße aus Österreich (Grüner Veltliner), spritzige Rosés
EOF

      ai-brain ---y "=> writing Elektronikentwicklung masterspaces"
      cat > ~/§Privat/Elektronikentwicklung/@/bauteil-bestand.md <<'EOF'
# Bauteil-Bestand und Hersteller-Präferenzen

## Im Lager

- Mikrocontroller: STM32 (G0/F4-Serie), ESP32, RP2040
- Op-Amps: TL072, OPA2134, MCP6004
- Spannungsregler: LM317, LDOs MCP1700, AMS1117
- Passive: E12-Widerstandsserie 0805, MLCCs X7R bis 10 µF

## Bevorzugte Hersteller

- ICs: Texas Instruments, ST Microelectronics, Microchip
- Passive: Vishay, Murata, Kemet
- Steckverbinder: Phoenix Contact (Schraubklemmen), Molex (Pinheader)

## Distributoren

- Erstwahl Mouser, alternativ Digi-Key
- Lokal: RS Components Österreich
EOF

      cat > ~/§Privat/Elektronikentwicklung/Leistungselektronik/@/leistungsdesign-notizen.md <<'EOF'
# Leistungselektronik — Designnotizen

## Bewährte Topologien

- Buck-Converter: TPS62xxx-Familie für 12 V → 5 V / 3.3 V bis 1 A
- Linearer Vorregler vor empfindlicher Analogstufe (LDO mit niedrigem PSRR)
- Synchron-Buck bei > 1 A, asynchron darunter
- Ladungspumpen für 5 V → ±5 V symmetrisch (LM27761)

## Eigene Erfahrungen

- Layout: Stromschleifen so klein wie möglich, Switching-Node-Fläche minimieren
- Eingangs-Caps: mindestens 10 µF Keramik direkt am IC, 100 µF Bulk
- Snubber an MOSFET-Schaltern: RC-Glied dimensioniert nach Resonanz
- EMV: Ferrit-Bead in V_in bei längerer Zuleitung
EOF

      cat > ~/§Privat/Elektronikentwicklung/HF-Elektronik/@/hf-design-notizen.md <<'EOF'
# HF-Elektronik — Designnotizen

## Bevorzugte Topologien

- Antennen-Matching: Pi-Netzwerk für 50 Ω auf 2.4 GHz
- Bandpass: LC-Filter 3. Ordnung für Schmalband-Anwendungen
- Tiefpass am ADC-Eingang: RC + L für Anti-Aliasing
- Balun: integrierte Bauteile (Murata LFB-Serie) statt diskreter Übertrager

## EMV-Erfahrungen

- Massefläche durchgehend, möglichst ohne Schnitte unter HF-Bahnen
- Via-Stitching am Rand der GND-Fläche (Abstand λ/20)
- Schirmung: kleine Blech-Käppchen (Würth WE-SHC) statt Vollblechen
- ESD: TVS-Dioden möglichst nahe am Steckverbinder

## Messtechnik

- VNA: NanoVNA-V2 reicht für die meisten Hobby-Anpassungen bis 3 GHz
- Spektrum: TinySA für Voruntersuchungen, RSA für ernsthafte Messungen
EOF

      ai-brain ---g "OK — demo AI-Brain created at ~/§Privat (7 masterspaces populated)"
      ai-brain ---c "next step: ai-brain --setup   # register the hook so Claude Code uses the context"
      exit 0
   fi

#===============================================================================
# context dump: ai-brain --context  (collects masterspace .md files along cwd→/)
#===============================================================================

   if [ "$*" == "--context" ]; then
      #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
      LOG=~/.claude/log
      if [ ! -d $LOG ]; then
          mkdir $LOG
      fi
      TIMESTAMP=$(date +"%Y-%m-%d %H:%M:%S")
      echo "$TIMESTAMP: ai-brain --context: "$(pwd) >>$LOG/ai-brain.log
      #<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<$LOG<<<<<<<<<<<<<<<<<<<<<<

      # begin/end markers carry the masterspace id, so that Claude (hook
      # --advise, skill /masterspace) can verify a complete load
      read -r ID N <<< "$(ai-brain ---hash)"
      echo "<masterspace id=\"$ID\" files=\"$N\" cwd=\"$PWD\">"
      ai-brain ---dirs | while IFS= read -r S; do
         ai-brain ---g "=> processing $S" >&2
         find "$S" -name "*.md" | sort | while IFS= read -r f; do
            echo "<skill src=\"$f\">"
            cat "$f"
            echo "</skill>"
         done
      done
      echo "</masterspace id=\"$ID\">"
      exit 0
   fi

#===============================================================================
# internal helpers (undocumented self-calls, operating on cwd):
#   ai-brain ---root   # AI-Brain root (nearest §-prefixed ancestor) or empty
#   ai-brain ---dirs   # masterspace @-folders from / down to cwd
#   ai-brain ---files  # .md files of these masterspaces, in context order
#   ai-brain ---hash   # "<id> <number of files>" (id: 8 hex over cwd+files)
#===============================================================================

   if [ "$*" == "---root" ]; then
      D="$PWD"
      while [ "$D" != "/" ]; do
         case "$(basename "$D")" in
            §*) echo "$D"; exit 0 ;;
         esac
         D="$(dirname "$D")"
      done
      exit 0
   fi

   if [ "$*" == "---dirs" ]; then
      D="$PWD"
      A=()
      while [ "$D" != "/" ]; do
         A=("$D" "${A[@]}")
         D="$(dirname "$D")"
      done
      for D in "${A[@]}"; do
         if [ -d "$D/@" ]; then echo "$D/@"; fi
      done
      exit 0
   fi

   if [ "$*" == "---files" ]; then
      ai-brain ---dirs | while IFS= read -r S; do
         find "$S" -name "*.md" | sort
      done
      exit 0
   fi

   if [ "$*" == "---hash" ]; then
      FILES="$(ai-brain ---files)"
      N=0
      if [ -n "$FILES" ]; then N=$(printf '%s\n' "$FILES" | wc -l | tr -d ' '); fi
      ID=$( { echo "$PWD"
              printf '%s\n' "$FILES" | while IFS= read -r f; do
                 [ -n "$f" ] && { echo "$f"; cat "$f"; }
              done
            } | shasum -a 256 | cut -c1-8 )
      echo "$ID $N"
      exit 0
   fi

#===============================================================================
# no args: directory walk with masterspace listing
#   - cyan : project directories (those carrying an @/ masterspace)
#   - white: ancestor directories without @/
#   - green: .md filenames inside @/ directories
#===============================================================================

   if [ -z "$*" ]; then
      D="$PWD"
      A=()
      while [ "$D" != "/" ]; do
         A=("$D" "${A[@]}")
         D="$(dirname "$D")"
      done
      inside=0
      for D in "${A[@]}"; do
         # skip paths containing any dot-prefixed component (.claude, .pimp, .git, …)
         case "$D" in */.*) continue ;; esac
         # skip ancestors above the AI-Brain root (the first §-prefixed directory)
         if [ "$inside" -eq 0 ]; then
            case "$(basename "$D")" in
               §*) inside=1 ;;
               *)  continue ;;
            esac
         fi
         ai-brain ---c "$D"
         if [ -d "$D/@" ]; then
            find "$D/@" -name "*.md" | sort | (
               last=""
               while IFS= read -r f; do
                  p="$(dirname "$f")"
                  if [ "$p" != "$last" ]; then
                     echo "$p"
                     last="$p"
                  fi
                  ai-brain ---y "   $(basename "$f")"
               done
            )
         fi
      done
      exit 0
   fi

#===============================================================================
# internal color helpers: ai-brain ---r/g/y/b/m/c "text"
# (undocumented self-call dispatches that replace the external `ec` dependency
#  — same ANSI codes that bluccino/tool-ec emits)
#===============================================================================

   if [ "$1" == "---r" ]; then printf "\x1b[31m"; shift; echo "$*"; printf "\x1b[0m"; exit 0; fi
   if [ "$1" == "---g" ]; then printf "\x1b[32m"; shift; echo "$*"; printf "\x1b[0m"; exit 0; fi
   if [ "$1" == "---y" ]; then printf "\x1b[33m"; shift; echo "$*"; printf "\x1b[0m"; exit 0; fi
   if [ "$1" == "---b" ]; then printf "\x1b[34m"; shift; echo "$*"; printf "\x1b[0m"; exit 0; fi
   if [ "$1" == "---m" ]; then printf "\x1b[35m"; shift; echo "$*"; printf "\x1b[0m"; exit 0; fi
   if [ "$1" == "---c" ]; then printf "\x1b[36m"; shift; echo "$*"; printf "\x1b[0m"; exit 0; fi

#===============================================================================
# cannot deal with anything else ...
#===============================================================================

   ai-brain -?
   exit 1
